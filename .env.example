# Safe local defaults. Replace only in your own credential manager.
MSGRAPH_TENANT_ID=<AZURE_TENANT_ID>
MSGRAPH_CLIENT_ID=<AZURE_CLIENT_ID>
MSGRAPH_CLIENT_SECRET=<CLIENT_SECRET_NOT_INCLUDED>
MSGRAPH_SCOPE=https://graph.microsoft.com/.default
MSGRAPH_AUTHORITY_URL=https://login.microsoftonline.com
MSGRAPH_MAILBOX=<TEST_USER_EMAIL>

# Optional service-specific values for a consumer implementation.
MSTEAMS_TENANT_ID=<AZURE_TENANT_ID>
MSTEAMS_CLIENT_ID=<AZURE_CLIENT_ID>
MSTEAMS_CLIENT_SECRET=<CLIENT_SECRET_NOT_INCLUDED>
MSTEAMS_RESOURCE_REGISTRY=<LOCAL_RESOURCE_REGISTRY>
POWERPLATFORM_TENANT_ID=<AZURE_TENANT_ID>
POWERPLATFORM_CLIENT_ID=<AZURE_CLIENT_ID>
POWERPLATFORM_CLIENT_SECRET=<CLIENT_SECRET_NOT_INCLUDED>
POWERPLATFORM_DATAVERSE_URL=<DEV_DATAVERSE_URL>
